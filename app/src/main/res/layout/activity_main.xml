<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <EditText android:id="@+id/etEventName" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Etkinlik Adı (örn: Tatil)" />
    <EditText android:id="@+id/etTargetDate" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="Hedef Tarih (YYYY-AA-GG)" android:inputType="date" />
    <Button android:id="@+id/btnSave" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Kaydet ve Widget'ı Güncelle" android:layout_marginTop="16dp" />
</LinearLayout>
